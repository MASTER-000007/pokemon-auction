# ------------------------------------------------------------------
# Flask
# ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
PORT=5000

# ------------------------------------------------------------------
# Database
# SQLite (default dev):  leave DATABASE_URL empty
# PostgreSQL (prod):     postgresql://user:pass@host:5432/dbname
# ------------------------------------------------------------------
DATABASE_URL=

# Auto-create tables on boot (handy on Render/Railway first deploy)
AUTO_CREATE_DB=true

# ------------------------------------------------------------------
# Game defaults (also editable per-room by the host in the lobby)
# ------------------------------------------------------------------
STARTING_COINS=1000
TEAM_SIZE=4
MIN_PLAYERS=2
MAX_PLAYERS=8
AUCTION_DURATION=20
MIN_BID_INCREMENT=10
ANTI_SNIPE_ENABLED=true
ANTI_SNIPE_SECONDS=5
ALLOW_DUPLICATES=false
ALLOW_LEGENDARIES=true
ALLOW_MYTHICALS=true
SHOW_PLAYER_BALANCES=true

# ------------------------------------------------------------------
# PokéAPI cache
# POKEMON_LIMIT=1025 -> all standard base-form Pokémon (Gen 1-9)
# Use 151 for a fast first boot.
# ------------------------------------------------------------------
POKEMON_LIMIT=1025
POKEMON_FETCH_WORKERS=12
